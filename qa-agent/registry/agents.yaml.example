# Example registry — specialists after spt-agent extract
# Full file: am-agents/support-agent/registry/agents.yaml
# Plan-only; not deployed from .github

version: 1

platform:
  agent_id: support-agent
  display_name: Support Agent

defaults:
  prefer: tool-agent
  budgets:
    max_fanout: 8
    max_latency_ms: 120000
    max_cost_units: 100

agents:
  - agent_id: tool-agent
    display_name: Tool Agent
    base_url_env: TOOL_AGENT_BASE_URL
    default_base_url: http://127.0.0.1:8141
    preferred: true
    health_path: /health
    ready_path: /ready
    capabilities:
      - id: tools.plan
        ops: [discover, plan, execute, stream]
      - id: tools.execute
        ops: [discover, plan, execute, stream]
      - id: tools.query
        ops: [discover, execute, stream]
    # Routes: backend, network, observe — NOT load/perf after cutover

  - agent_id: spt-agent
    display_name: SPT Agent
    base_url_env: SPT_AGENT_BASE_URL
    default_base_url: http://127.0.0.1:8150
    preferred: true
    health_path: /health
    ready_path: /ready
    capabilities:
      - id: spt.prepare
        ops: [execute]
      - id: spt.execute
        ops: [execute, status, cancel]
      - id: spt.status
        ops: [status]
    # Routes: load / perf / synthetic only
    # No orchestration — single-target executor

  - agent_id: ui-test-agent
    display_name: UI Test Agent
    base_url_env: UI_TEST_AGENT_BASE_URL
    default_base_url: http://127.0.0.1:8130
    preferred: true
    health_path: /health
    capabilities:
      - id: ui.test.run
        ops: [discover, plan, execute, status, stream]
      - id: ui.test.report
        ops: [discover, status]

  - agent_id: db-agent
    display_name: DB Agent
    base_url_env: DB_AGENT_BASE_URL
    default_base_url: http://127.0.0.1:8140
    preferred: false
    tags: [legacy.db-agent]
    capabilities:
      - id: db.execute
        ops: [discover, plan, execute]

# fin-agent is NOT registered — finance is a separate product surface.
# Orchestration is NEVER registered as a specialist target.
